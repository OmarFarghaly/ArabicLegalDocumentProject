APP_NAME= "Arabic Legel Document"

ENGLISH_EMBEDDING="Qwen/Qwen3-Embedding-0.6B"

ARABIC_EMBEDDING="Omartificial-Intelligence-Space/Arabic-Triplet-Matryoshka-V2"

RERANKER_MODEL="Qwen/Qwen3-Reranker-0.6B"

COLLECTION_NAME = "legel_document"



RAW_PDF=data/raw/civil_code.pdf
ARTICLES_JSON=data/processed/articles.json

VALIDATE_SCHEMA=true
ENSURE_ASCII=false
INDENT=2

#====Reterival config ========

RETERIVAL_LIMIT=50
RETERIVAL_RRF_LIMIT=30
RETERIVAL_RERANKED_LIMIT=10

# Set this in your ignored local .env file; do not commit the real token.
HF_TOKEN=your_token
# ====Cache config ========
CACHE_ENABLED=false
CACHE_TTL_SECONDS=3600
CACHE_INDEX_VERSION=1
REDIS_HOST=localhost
REDIS_PORT=6379